# AI analysis is optional: without a key the app uses keyword tags and the stored sample results.
# LLM_PROVIDER: "openai" (default) uses OPENAI_API_KEY; "openrouter" uses OPENROUTER_API_KEY
# to call the same OpenAI models through OpenRouter.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Collect new reviews automatically every N hours while the API runs (0 = off). New reviews are
# analysed and briefings refreshed after each run when an AI key is set.
COLLECT_EVERY_HOURS=3
# OPENAI_MODEL=gpt-5-nano
# OPENAI_SUMMARY_MODEL=gpt-5-mini

# Webshare residential proxy for the collector. Booking.com blocks most datacenter IPs, so set this
# when the server is hosted (not needed on a home connection). Leave empty to connect directly.
WEBSHARE_HOST=
WEBSHARE_PORT=
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
# WEBSHARE_COUNTRY=au      # country of the residential IP; empty for any country
# DISABLE_PROXY=true       # connect directly even when the WEBSHARE_* values are set
