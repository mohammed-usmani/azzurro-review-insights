# AI analysis is optional: without a key the app uses keyword tags and the stored sample results.
# LLM_PROVIDER: "openai" (default) uses OPENAI_API_KEY; "openrouter" uses OPENROUTER_API_KEY
# to call the same OpenAI models through OpenRouter.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_MODEL=gpt-5-nano
# OPENAI_SUMMARY_MODEL=gpt-5-mini
